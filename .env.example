# Frontend (Vite) — copy to .env.local
# Project Settings -> API in the Supabase dashboard
# These two are public client keys (anon). Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional frontend flags (not secrets). Presence/value only.
# Platform fee basis points, e.g. 1000 = 10%. Leave unset if fees are not configured.
# VITE_PLATFORM_FEE_BPS=1000
# Set to any non-empty value only if a verification API is actually connected.
# VITE_VERIFICATION_API=

# Server-only secrets — set on Supabase Edge Functions or the host. Never prefix with VITE_.
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
