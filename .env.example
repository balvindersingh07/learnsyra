# Frontend (Vite) — copy to .env.local
# App shell: public (www) or admin (admin subdomain). Defaults to public when unset.
VITE_APP_MODE=public

# Project Settings -> API in the Supabase dashboard
# These two are public client keys (anon). Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional frontend flags (not secrets). Presence/value only.
# Platform fee basis points, e.g. 1000 = 10%. Leave unset if fees are not configured.
# VITE_PLATFORM_FEE_BPS=1000
# Set to any non-empty value only if a verification API is actually connected.
# VITE_VERIFICATION_API=

# Server-only secrets — set on Supabase Edge Functions or the host. Never prefix with VITE_.
# OPENAI_API_KEY=   # required for ai-tutor Edge Function
# Deploy: supabase functions deploy ai-tutor
# Transactional notification email (Resend) — Edge Function secrets only
# RESEND_API_KEY=
# EMAIL_FROM=LearnSyra <notifications@your-domain.com>
# APP_BASE_URL=https://learnsyra.com
# NOTIFICATIONS_EMAIL_ENABLED=true
# Deploy: supabase functions deploy deliver-notification-email
# Razorpay (India launch — active monthly subscriptions)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Create monthly plans in Razorpay Dashboard, then paste plan IDs here:
# RAZORPAY_PLAN_ID_STUDENT_PRO=
# RAZORPAY_PLAN_ID_CAREER_PRO=
# Marketplace webhook (separate from subscription webhook):
# RAZORPAY_MARKETPLACE_WEBHOOK_SECRET=
# Route Linked Account onboarding + Direct Transfers (Phase A/B).
# Does not change marketplace checkout or subscription payments.
# RAZORPAY_ROUTE_ENABLED=true
# Optional dedicated webhook secret for transfer events (falls back to marketplace secret if unset):
# RAZORPAY_ROUTE_WEBHOOK_SECRET=
# Stripe (worldwide — deferred)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Real job platform (Edge Function secrets — never VITE_)
# SYNC_JOBS_CRON_SECRET=            # required header x-sync-jobs-secret for scheduled sync-jobs calls
# Deploy: supabase functions deploy sync-jobs
# Provider API keys (when configured) belong in Supabase Edge Function secrets only — not in VITE_* vars.
#
# Optional frontend flags (not secrets)
# VITE_DEV_MOCK_JOBS=true            # DEV only — legacy mock catalog fallback
# VITE_JOB_MATCH_MIN_SCORE=35
